# Comma-separated production origins for CORS (dev localhost origins are always allowed)
ALLOWED_ORIGINS=https://your-production-domain.example
# Optional bearer token for /api/save-url
SAVE_URL_TOKEN=
# Injected by the Upstash Vercel integration; leave empty for in-memory dev fallback
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Frontend (already required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
